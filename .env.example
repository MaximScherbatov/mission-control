# Домен, который обслуживает Caddy
APP_RELEASE=2026.09.22-replay-airspace.1
ALLOWED_ORIGINS=https://mission.citymetrics.moscow
COOKIE_SECURE=true

# Сгенерируйте разные длинные случайные значения перед первым запуском
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-64-random-characters
DEMO_DISPATCHER_PASSWORD=replace-dispatcher-password
DEMO_MANAGER_PASSWORD=replace-manager-password
DEMO_ADMIN_PASSWORD=replace-admin-password

# Необязательный информационный слой воздушного движения.
# В auto сначала используется локальный readsb (если задан), затем OpenSky.
AIRCRAFT_SOURCE=auto
# Оставьте пустым для безопасного автоинтервала: 240 с без ключей OpenSky,
# 25 с с OAuth OpenSky или 3 с при AIRCRAFT_SOURCE=readsb.
AIRCRAFT_CACHE_TTL_SECONDS=
AIRCRAFT_RADIUS_NM=130
READSB_URL=
# Без ключей OpenSky работает анонимно с суточной квотой; OAuth ускоряет обновление.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# airplanes.live требует предварительного согласования проекта; без него оставьте false.
AIRPLANES_LIVE_ENABLED=false

# Необязательно: поиск и автозаполнение карточки заказчика.
DADATA_API_KEY=
DADATA_CACHE_TTL_SECONDS=86400

# Погода и радар без API-ключей. Уменьшение размера/числа кадров экономит память NAS.
WEATHER_CACHE_TTL_SECONDS=600
RADAR_CACHE_TTL_SECONDS=300
RADAR_OUTPUT_PX=900
RADAR_FRAMES=12

# Используется только с docker-compose.local.yml
APP_PORT=8080
